AI_MAX_TOKENS=
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_MODEL=
AUTH_SECRET=
CRON_SECRET=
DATABASE_URL=
EAZO_AI_PROVIDER_MODE=
GEMINI_API_KEY=
NEXT_PUBLIC_APP_DESCRIPTION=
NEXT_PUBLIC_APP_TITLE=
TAVILY_API_KEY=

# Email Verification - QQ 邮箱 / SMTP 发信服务
# QQ 邮箱账号（如：123456789@qq.com）
QQ_EMAIL_USER=
# QQ 邮箱 16 位 SMTP 授权码（QQ邮箱网页端 -> 设置 -> 账户 -> 开启 POP3/IMAP/SMTP 服务生成）
QQ_EMAIL_PASS=
# 可选：SMTP 服务器地址，默认 smtp.qq.com（支持 smtp.163.com、smtp.exmail.qq.com 等）
SMTP_HOST=
# 可选：SMTP 端口，默认 465（SSL）
SMTP_PORT=
# 可选：发件人名称，默认 "拾级 Gradus"
EMAIL_FROM=

# Watcha (观猹) OAuth 2.0
# 在 Vercel Production 中填写已登记的固定回调地址，避免 Preview URL 与观猹登记域名不一致。
WATCHA_REDIRECT_URI=https://talk-task.vercel.app/api/auth/oauth/watcha/callback
WATCHA_CLIENT_ID=
WATCHA_CLIENT_SECRET=
# 以下地址已内置为观猹官方默认值；仅在对方另行提供测试环境地址时覆盖。
WATCHA_AUTH_URL=https://watcha.cn/oauth/authorize
WATCHA_TOKEN_URL=https://watcha.cn/oauth/api/token
WATCHA_USERINFO_URL=https://watcha.cn/oauth/api/userinfo
