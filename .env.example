# Email Verification - QQ 邮箱 / SMTP 发信服务
# QQ 邮箱账号（如：123456789@qq.com）
QQ_EMAIL_USER=
# QQ 邮箱 16 位 SMTP 授权码（QQ邮箱网页端 -> 设置 -> 账户 -> 开启 POP3/IMAP/SMTP 服务生成）
QQ_EMAIL_PASS=
# 可选：SMTP 服务器地址，默认 smtp.qq.com（支持 smtp.163.com、smtp.exmail.qq.com 等）
SMTP_HOST=
# 可选：SMTP 端口，默认 465（SSL）
SMTP_PORT=
# 可选：发件人名称，默认 "拾级 Gradus"
EMAIL_FROM=

# Watcha (观猹) OAuth 2.0
WATCHA_CLIENT_ID=
WATCHA_CLIENT_SECRET=
WATCHA_AUTH_URL=
WATCHA_TOKEN_URL=
WATCHA_USERINFO_URL=
