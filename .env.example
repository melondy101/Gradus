AI_MAX_TOKENS=
# BYOK：自带 OpenAI 兼容端点。BASE_URL 必须写到 /v1 这一层，代码自动拼 /chat/completions
AI_PROVIDER_API_KEY=
AI_PROVIDER_BASE_URL=
AI_PROVIDER_MODEL=
# 二选一：gemini 或 byok。留空则自动判断——BYOK 三件套齐了且没有 GEMINI_API_KEY 就走 byok。
# 只在「Gemini 与 BYOK 都配了、想强制走某一条」时才需要显式设。
AI_PROVIDER_MODE=
AUTH_SECRET=
# 可选：设 1 则跳过 AUTH_SECRET 校验，用本地占位串签名。仅供本地手测，生产设了这个等于关掉防伪造
AUTH_SECRET_ALLOW_INSECURE=
# 管理员邮箱：服务端 API 使用 ADMIN_EMAIL；前端显示管理入口还需填写同值的 NEXT_PUBLIC_ADMIN_EMAIL。
ADMIN_EMAIL=
ADMIN_PASSWORD=
NEXT_PUBLIC_ADMIN_EMAIL=
CRON_SECRET=
DATABASE_URL=
GEMINI_API_KEY=
NEXT_PUBLIC_APP_DESCRIPTION=
NEXT_PUBLIC_APP_TITLE=
# 资源搜索：按 Tavily → SerpAPI → Brave → 豆包顺序回退；至少填一个即可。
# 当前服务限额、鉴权失败、超时或没有白名单结果时，会尝试下一个已配置服务。
TAVILY_API_KEY=
SERPAPI_API_KEY=
BRAVE_SEARCH_API_KEY=
DOUBAO_API_KEY=
# 「检查更新」：读 GitHub Release。GITHUB_REPOSITORY 缺省时从 VERCEL 的 GITHUB_REPOSITORY 推断
GITHUB_TOKEN=
GITHUB_REPOSITORY=
NEXT_PUBLIC_GITHUB_REPO=
# 语雀 / 飞书工作区导入
YUQUE_API_TOKEN=
FEISHU_USER_TOKEN=

# Email Verification - QQ 邮箱 / SMTP 发信服务
# 二选一：填 QQ_EMAIL_USER/PASS，或填 SMTP_USER/PASS（mailer.ts 按 QQ_EMAIL_* 优先回退 SMTP_*）
# QQ 邮箱账号（如：123456789@qq.com）
QQ_EMAIL_USER=
# QQ 邮箱 16 位 SMTP 授权码（QQ邮箱网页端 -> 设置 -> 账户 -> 开启 POP3/IMAP/SMTP 服务生成）
QQ_EMAIL_PASS=
# 非 QQ 邮箱时用这套；SMTP_USER/PASS 是登录凭据，缺了 mailer 直接返回「未检测到 SMTP 用户名」
SMTP_USER=
SMTP_PASS=
# 可选：SMTP 服务器地址，默认 smtp.qq.com（支持 smtp.163.com、smtp.exmail.qq.com 等）
SMTP_HOST=
# 可选：SMTP 端口，默认 465（SSL）
SMTP_PORT=
# 可选：是否走 SSL，默认 true。端口 587（STARTTLS）时设 false
SMTP_SECURE=
# 可选：发件人名称，默认 "拾级 Gradus"
EMAIL_FROM=
# 两者都不配时回落 mock 发信：验证码以 toast「[开发提示] 模拟验证码：xxxxxx」弹出，真实收信测不到

# Watcha (观猹) OAuth 2.0
# 在 Vercel Production 中填写已登记的固定回调地址，避免 Preview URL 与观猹登记域名不一致。
WATCHA_REDIRECT_URI=https://talk-task.vercel.app/api/auth/oauth/watcha/callback
WATCHA_CLIENT_ID=
WATCHA_CLIENT_SECRET=
# 以下地址已内置为观猹官方默认值；仅在对方另行提供测试环境地址时覆盖。
WATCHA_AUTH_URL=https://watcha.cn/oauth/authorize
WATCHA_TOKEN_URL=https://watcha.cn/oauth/api/token
WATCHA_USERINFO_URL=https://watcha.cn/oauth/api/userinfo
